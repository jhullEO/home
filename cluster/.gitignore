Makefile
compile_commands.json
CTestTestfile.cmake

# Compiled objects / libraries / executables
*.o
*.obj
*.a
*.so
*.so.*
*.dll
*.dylib
*.exe
*.out


# ============================================================
# CLion / JetBrains
# ============================================================

.idea/
*.iml


# ============================================================
# vcpkg
# ============================================================

# If we later use vcpkg manifest mode, dependencies are
# restored from vcpkg.json rather than committed.
vcpkg_installed/


