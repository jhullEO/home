# ============================================================

node_modules/

.next/
out/
dist/
coverage/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Next.js local environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Keep example/template environment files
!.env.example


